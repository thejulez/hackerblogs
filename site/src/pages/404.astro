---
import Base from "../layouts/Base.astro";
---

<Base title="Not found · Hacker Blogs" noindex>
  <section class="nf">
    <h1>Not here</h1>
    <p class="muted">
      This page doesn't exist, or the blog isn't listed yet. We're still checking sites Hacker News links to and add more every
      week.
    </p>
    <p><a class="btn primary" href="/">All blogs</a> <a class="btn" href="/random">A random blog</a></p>
  </section>
</Base>
<style>
  .nf {
    padding-top: 40px;
  }
  .nf p {
    max-width: 60ch;
  }
</style>
